---
import type { ProjectCatalogIconName } from '../data/projectCatalog';

interface Props {
  name: ProjectCatalogIconName;
}

const { name } = Astro.props;
---

<svg
  class="group-icon"
  viewBox="0 0 80 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'professional' ? (
      <>
        <rect x="9" y="20" width="62" height="36" rx="5" />
        <path d="M28 20v-8h24v8M9 33c20 12 42 12 62 0" />
        <rect x="35" y="32" width="10" height="12" rx="2" class="signal" />
        <path d="M40 25v7m0 12v5" class="signal" />
      </>
    ) : (
      <>
        <rect x="7" y="10" width="66" height="44" rx="5" />
        <path d="M7 21h66M16 16h1m5 0h1m5 0h1M29 31l-8 7 8 7m22-14 8 7-8 7" />
        <path d="M44 28l-8 21" class="signal" />
      </>
    )
  }
</svg>

<style>
  .group-icon {
    display: block;
    width: 5rem;
    height: 4rem;
    margin-bottom: 1rem;
    color: var(--ink-2);
  }
  .group-icon .signal {
    stroke: var(--accent);
  }
</style>
