---
// Hand-drawn technical line-art per project, datasheet style.
// Pure inline SVG — inherits the site theme through CSS variables.
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className } = Astro.props;
---

{
  slug === 'connected-driving' && (
    <svg class:list={['art', className]} viewBox="0 0 640 240" role="img" aria-label="Two vehicles exchanging messages directly over the PC5 sidelink">
      {/* road */}
      <line x1="20" y1="204" x2="620" y2="204" class="s-ink3" />
      <line x1="20" y1="212" x2="620" y2="212" class="s-hair" stroke-dasharray="14 10" />
      {/* car A */}
      <g>
        <rect x="120" y="152" width="104" height="38" rx="10" class="s-ink f-none" stroke-width="2" />
        <path d="M 140 152 Q 148 128 168 128 L 196 128 Q 212 128 220 152" class="s-ink f-none" stroke-width="2" />
        <circle cx="146" cy="192" r="11" class="s-ink f-bg" stroke-width="2" />
        <circle cx="198" cy="192" r="11" class="s-ink f-bg" stroke-width="2" />
        <line x1="172" y1="128" x2="172" y2="108" class="s-accent" stroke-width="2" />
        <circle cx="172" cy="105" r="3" class="f-accent" />
      </g>
      {/* car B */}
      <g>
        <rect x="416" y="152" width="104" height="38" rx="10" class="s-ink f-none" stroke-width="2" />
        <path d="M 436 152 Q 444 128 464 128 L 492 128 Q 508 128 516 152" class="s-ink f-none" stroke-width="2" />
        <circle cx="442" cy="192" r="11" class="s-ink f-bg" stroke-width="2" />
        <circle cx="494" cy="192" r="11" class="s-ink f-bg" stroke-width="2" />
        <line x1="468" y1="128" x2="468" y2="108" class="s-accent" stroke-width="2" />
        <circle cx="468" cy="105" r="3" class="f-accent" />
      </g>
      {/* PC5 link */}
      <path d="M 180 100 Q 320 30 460 100" class="s-accent f-none" stroke-width="2" />
      <path d="M 180 100 l 10 -8 M 180 100 l 12 3" class="s-accent" stroke-width="2" />
      <path d="M 460 100 l -10 -8 M 460 100 l -12 3" class="s-accent" stroke-width="2" />
      <text x="320" y="52" class="label" text-anchor="middle">PC5 · direct V2V</text>
      {/* no base station: crossed mast, faint */}
      <g class="faint">
        <line x1="588" y1="204" x2="588" y2="120" class="s-ink3" stroke-width="2" />
        <path d="M 578 132 L 598 120 M 578 120 L 598 132" class="s-ink3" stroke-width="2" />
      </g>
    </svg>
  )
}

{
  slug === 'v2x-protocol-stack' && (
    <svg class:list={['art', className]} viewBox="0 0 640 240" role="img" aria-label="A V2X protocol stack from application layer down to the radio">
      {/* layer boxes */}
      <g>
        <rect x="90" y="30" width="220" height="36" rx="6" class="s-ink3 f-code" />
        <text x="200" y="53" class="label" text-anchor="middle">APPLICATION</text>
        <rect x="90" y="78" width="220" height="36" rx="6" class="s-ink3 f-code" />
        <text x="200" y="101" class="label" text-anchor="middle">MESSAGES · SAE J2735</text>
        <rect x="90" y="126" width="220" height="36" rx="6" class="s-ink3 f-code" />
        <text x="200" y="149" class="label" text-anchor="middle">NETWORK · ETSI ITS</text>
        <rect x="90" y="174" width="220" height="36" rx="6" class="s-accent f-code" stroke-width="2" />
        <text x="200" y="197" class="label" text-anchor="middle">ACCESS · 3GPP SIDELINK</text>
      </g>
      {/* descent path */}
      <path d="M 330 48 L 356 48 L 356 96 L 330 96 M 356 96 L 356 144 L 330 144 M 356 144 L 356 192 L 330 192" class="s-ink3 f-none" stroke-dasharray="5 5" />
      {/* to the antenna */}
      <path d="M 310 192 L 470 192" class="s-accent f-none" stroke-width="2" style="marker-end: none" />
      <path d="M 470 192 l -12 -6 M 470 192 l -12 6" class="s-accent" stroke-width="2" />
      {/* antenna mast */}
      <line x1="496" y1="210" x2="496" y2="96" class="s-ink" stroke-width="2" />
      <path d="M 482 210 L 510 210" class="s-ink" stroke-width="2" />
      <path d="M 488 96 L 504 96 L 496 116 Z" class="s-ink f-none" stroke-width="2" />
      {/* radiating arcs */}
      <path d="M 512 84 Q 528 100 512 116" class="s-accent f-none" stroke-width="2" />
      <path d="M 524 72 Q 548 100 524 128" class="s-ink3 f-none" stroke-width="2" />
      <path d="M 536 60 Q 568 100 536 140" class="s-hair2 f-none" stroke-width="2" />
      <text x="200" y="230" class="label faint" text-anchor="middle">every field traceable to a clause</text>
    </svg>
  )
}

{
  slug === 'digital-twin-channel-sim' && (
    <svg class:list={['art', className]} viewBox="0 0 640 240" role="img" aria-label="Radio rays bouncing between buildings from one vehicle to another">
      {/* ground */}
      <line x1="20" y1="204" x2="620" y2="204" class="s-ink3" />
      {/* buildings */}
      <rect x="150" y="92" width="64" height="112" class="s-ink f-code" stroke-width="2" />
      <rect x="270" y="56" width="76" height="148" class="s-ink f-code" stroke-width="2" />
      <rect x="410" y="110" width="56" height="94" class="s-ink f-code" stroke-width="2" />
      {/* grid hint on the tall building */}
      <path d="M 286 72 h 44 M 286 92 h 44 M 286 112 h 44 M 286 132 h 44" class="s-hair" />
      {/* TX / RX cars */}
      <g>
        <rect x="52" y="182" width="64" height="22" rx="7" class="s-ink f-none" stroke-width="2" />
        <line x1="84" y1="182" x2="84" y2="166" class="s-accent" stroke-width="2" />
        <circle cx="84" cy="163" r="3" class="f-accent" />
        <text x="84" y="228" class="label" text-anchor="middle">TX</text>
      </g>
      <g>
        <rect x="524" y="182" width="64" height="22" rx="7" class="s-ink f-none" stroke-width="2" />
        <line x1="556" y1="182" x2="556" y2="166" class="s-accent" stroke-width="2" />
        <circle cx="556" cy="163" r="3" class="f-accent" />
        <text x="556" y="228" class="label" text-anchor="middle">RX</text>
      </g>
      {/* rays */}
      <path d="M 84 160 L 270 96 L 556 160" class="s-accent f-none" stroke-width="2" />
      <circle cx="270" cy="96" r="3.5" class="f-accent" />
      <path d="M 84 160 L 150 128 L 410 150 L 556 160" class="s-ink3 f-none" stroke-dasharray="6 5" />
      <circle cx="150" cy="128" r="3" class="f-ink3" />
      <circle cx="410" cy="150" r="3" class="f-ink3" />
      <path d="M 84 160 Q 320 246 556 160" class="s-hair2 f-none" stroke-dasharray="3 6" />
      <text x="320" y="36" class="label" text-anchor="middle">ray-traced channel</text>
    </svg>
  )
}

{
  slug === 'robotics-sim2real' && (
    <svg class:list={['art', className]} viewBox="0 0 640 240" role="img" aria-label="A simulated robot and the real robot, with the gap between them driven to zero">
      {/* SIM robot — dashed wireframe */}
      <g class="dash">
        <rect x="118" y="150" width="110" height="30" rx="9" class="s-ink2 f-none" stroke-width="2" />
        <circle cx="140" cy="188" r="10" class="s-ink2 f-none" stroke-width="2" />
        <circle cx="173" cy="192" r="10" class="s-ink2 f-none" stroke-width="2" />
        <circle cx="206" cy="188" r="10" class="s-ink2 f-none" stroke-width="2" />
        <line x1="150" y1="150" x2="150" y2="86" class="s-ink2" stroke-width="2" />
        <path d="M 150 92 L 196 74 L 224 88" class="s-ink2 f-none" stroke-width="2" />
        <path d="M 224 88 l 12 -8 M 224 88 l 10 10" class="s-ink2 f-none" stroke-width="2" />
      </g>
      <text x="173" y="228" class="label" text-anchor="middle">SIM</text>
      {/* REAL robot — solid */}
      <g>
        <rect x="412" y="150" width="110" height="30" rx="9" class="s-ink f-none" stroke-width="2" />
        <circle cx="434" cy="188" r="10" class="s-ink f-bg" stroke-width="2" />
        <circle cx="467" cy="192" r="10" class="s-ink f-bg" stroke-width="2" />
        <circle cx="500" cy="188" r="10" class="s-ink f-bg" stroke-width="2" />
        <line x1="444" y1="150" x2="444" y2="86" class="s-ink" stroke-width="2" />
        <path d="M 444 92 L 490 74 L 518 88" class="s-ink f-none" stroke-width="2" />
        <path d="M 518 88 l 12 -8 M 518 88 l 10 10" class="s-accent f-none" stroke-width="2" />
      </g>
      <text x="467" y="228" class="label" text-anchor="middle">REAL</text>
      {/* the gap */}
      <path d="M 258 132 L 382 132" class="s-accent f-none" stroke-width="2" />
      <path d="M 258 132 l 12 -7 M 258 132 l 12 7 M 382 132 l -12 -7 M 382 132 l -12 7" class="s-accent" stroke-width="2" />
      <text x="320" y="116" class="label" text-anchor="middle">gap → 0, measured</text>
      {/* replay trace under the arrow */}
      <path d="M 262 158 q 10 -12 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0" class="s-ink3 f-none" />
      <path d="M 262 166 q 10 -12 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0" class="s-hair2 f-none" />
    </svg>
  )
}

<style>
  .art {
    display: block;
    width: 100%;
    height: auto;
  }
  .s-ink {
    stroke: var(--ink);
  }
  .s-ink2 {
    stroke: var(--ink-2);
  }
  .s-ink3 {
    stroke: var(--ink-3);
  }
  .s-hair {
    stroke: var(--hairline);
  }
  .s-hair2 {
    stroke: var(--hairline);
  }
  .s-accent {
    stroke: var(--accent);
  }
  .f-none {
    fill: none;
  }
  .f-bg {
    fill: var(--bg);
  }
  .f-code {
    fill: var(--code-bg);
  }
  .f-accent {
    fill: var(--accent);
  }
  .f-ink3 {
    fill: var(--ink-3);
  }
  .label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    fill: var(--ink-2);
  }
  .faint {
    opacity: 0.55;
  }
  svg line,
  svg path,
  svg rect,
  svg circle {
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
