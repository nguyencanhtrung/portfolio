---
import { render, getCollection, type CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../layouts/Base.astro';
import { t, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  post: CollectionEntry<'blog'>;
  /** Whether a translation with the same key exists in the other locale. */
  hasTranslation: boolean;
}

const { locale, post, hasTranslation } = Astro.props;
const { Content, headings } = await render(post);
// ponytail: h2-only TOC by decision (posts have 3–7 h2s; h3 would blow past a screen)
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 2;

const other: Locale = locale === 'en' ? 'vi' : 'en';
const slug = post.id.replace(/^(en|vi)\//, '');
const altPath = hasTranslation ? localePath(other, `/blog/${slug}/`) : undefined;

const fmt = new Intl.DateTimeFormat(locale === 'vi' ? 'vi-VN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Series mode: posts sharing data.series (same language) get part label + prev/next.
const series = post.data.series;
let seriesPosts: CollectionEntry<'blog'>[] = [];
if (series) {
  seriesPosts = (
    await getCollection(
      'blog',
      (p) => p.data.series === series && p.data.lang === locale && !p.data.draft
    )
  ).sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
}
const pos = seriesPosts.findIndex((p) => p.id === post.id);
const prevPost = pos > 0 ? seriesPosts[pos - 1] : undefined;
const nextPost = pos >= 0 && pos < seriesPosts.length - 1 ? seriesPosts[pos + 1] : undefined;
const postPath = (p: CollectionEntry<'blog'>) =>
  localePath(locale, `/blog/${p.id.replace(/^(en|vi)\//, '')}/`);
const partLabel =
  series && pos >= 0
    ? locale === 'vi'
      ? `phần ${pos + 1}/${seriesPosts.length}`
      : `part ${pos + 1} of ${seriesPosts.length}`
    : '';
---

<Base locale={locale} title={`${post.data.title} — Canh-Trung Nguyen`} description={post.data.description} altPath={altPath}>
  <article class:list={['container', { 'has-toc': showToc }]} data-pagefind-body>
    {
      showToc && (
        <aside class="toc" data-pagefind-ignore>
          <nav aria-label={t(locale, 'blog.toc')}>
            <p class="toc-label mono">{t(locale, 'blog.toc')}</p>
            <ol id="toc-list">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )
    }
    <header class="head">
      <p class="back mono" data-pagefind-ignore><a href={localePath(locale, '/blog/')}>{t(locale, 'blog.backToList')}</a></p>
      <h1>{post.data.title}</h1>
      <p class="meta mono">
        <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
        {post.data.tags.length > 0 && <span> · {post.data.tags.map((tag) => `#${tag}`).join(' ')}</span>}
      </p>
      {
        series && (
          <p class="series mono">
            {series} · {partLabel}
          </p>
        )
      }
      {
        altPath && (
          <p class="switch" data-pagefind-ignore>
            <a href={altPath} rel="alternate" hreflang={other}>
              {t(locale, 'blog.readInOther')}
            </a>
          </p>
        )
      }
    </header>
    {
      showToc && (
        <details class="toc-m" data-pagefind-ignore>
          <summary class="mono">{t(locale, 'blog.toc')}</summary>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }
    <div class="prose">
      <Content />
    </div>
    {
      (prevPost || nextPost) && (
        <nav class="series-nav" aria-label={series} data-pagefind-ignore>
          {prevPost ? (
            <a class="s-card" href={postPath(prevPost)} rel="prev">
              <span class="s-label mono">{t(locale, 'blog.seriesPrev')}</span>
              <span class="s-title">{prevPost.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {nextPost && (
            <a class="s-card s-next" href={postPath(nextPost)} rel="next">
              <span class="s-label mono">{t(locale, 'blog.seriesNext')}</span>
              <span class="s-title">{nextPost.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <script>
    // Sidebar TOC scroll state: sections above the reading line dim, the current one highlights.
    const list = document.getElementById('toc-list');
    if (list) {
      const links = Array.from(list.querySelectorAll('a'));
      const heads = links
        .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
        .filter((h): h is HTMLElement => h !== null);

      let ticking = false;
      const update = () => {
        ticking = false;
        const line = window.innerHeight * 0.3; // reading line: 30% down the viewport
        let current = -1;
        for (let i = 0; i < heads.length; i++) {
          if (heads[i].getBoundingClientRect().top <= line) current = i;
        }
        links.forEach((a, i) => {
          a.classList.toggle('is-active', i === current);
          a.classList.toggle('is-past', i < current);
        });
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  </script>

  <script>
    import mermaid from 'mermaid';

    const blocks = document.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]');

    if (blocks.length > 0) {
      // Swap each highlighted <pre> for a container that remembers its source,
      // so diagrams can be re-rendered when the theme changes.
      blocks.forEach((pre, i) => {
        const figure = document.createElement('div');
        figure.className = 'mermaid-figure';
        figure.dataset.source = pre.textContent ?? '';
        figure.id = `mermaid-fig-${i}`;
        pre.replaceWith(figure);
      });

      const renderAll = async () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        const css = getComputedStyle(document.documentElement);
        const v = (name: string) => css.getPropertyValue(name).trim();
        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          themeVariables: {
            darkMode: dark,
            background: v('--bg'),
            primaryColor: v('--code-bg'),
            primaryTextColor: v('--ink'),
            primaryBorderColor: v('--ink-3'),
            secondaryColor: v('--accent-soft'),
            tertiaryColor: v('--surface'),
            lineColor: v('--ink-2'),
            textColor: v('--ink'),
            noteBkgColor: v('--accent-soft'),
            noteTextColor: v('--ink'),
            noteBorderColor: v('--hairline'),
            actorBkg: v('--code-bg'),
            actorBorder: v('--ink-3'),
            actorTextColor: v('--ink'),
            signalColor: v('--ink-2'),
            signalTextColor: v('--ink'),
            activationBkgColor: v('--accent-soft'),
            fontSize: '14px',
          },
          fontFamily: 'JetBrains Mono, monospace',
        });
        const figures = document.querySelectorAll<HTMLElement>('.mermaid-figure');
        for (const fig of figures) {
          try {
            const { svg } = await mermaid.render(`${fig.id}-svg-${Date.now()}`, fig.dataset.source ?? '');
            fig.innerHTML = svg;
          } catch {
            fig.innerHTML = `<pre>${fig.dataset.source ?? ''}</pre>`;
          }
        }
      };

      renderAll();
      window.addEventListener('themechange', renderAll);
    }
  </script>

  <style>
    .head {
      padding-top: 4rem;
      max-width: var(--w-content);
    }
    .back {
      font-size: 0.75rem;
      margin-bottom: 2rem;
    }
    .back a {
      color: var(--ink-3);
    }
    .back a:hover {
      color: var(--accent);
    }
    h1 {
      font-size: clamp(2rem, 5vw, 2.8rem);
    }
    .meta {
      margin-top: 1rem;
      font-size: 0.75rem;
      color: var(--ink-3);
    }
    .switch {
      margin-top: 0.75rem;
      font-size: 0.9rem;
    }
    .prose {
      margin-top: 2.5rem;
    }
    .series {
      margin-top: 0.6rem;
      font-size: 0.75rem;
      color: var(--accent);
    }

    /* --- Series prev/next --- */
    .series-nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      max-width: var(--w-content);
      margin-top: 3.5rem;
      padding-top: 2rem;
      border-top: 1px dashed var(--ink-3);
    }
    .s-card {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      padding: 1rem 1.2rem;
      border: 1px solid var(--hairline);
      border-radius: 10px;
      background: var(--surface);
      color: inherit;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .s-card:hover {
      text-decoration: none;
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .s-next {
      text-align: right;
    }
    .s-label {
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .s-card:hover .s-label {
      color: var(--accent);
    }
    .s-title {
      font-size: 0.92rem;
      line-height: 1.4;
      color: var(--ink-2);
    }
    @media (max-width: 640px) {
      .series-nav {
        grid-template-columns: 1fr;
      }
      .s-next {
        text-align: left;
      }
    }

    /* --- Table of contents --- */
    /* Mobile / narrow: collapsed block above the prose. */
    .toc {
      display: none;
    }
    .toc-m {
      margin-top: 2rem;
      border: 1px solid var(--hairline);
      border-radius: 8px;
      background: var(--surface);
      max-width: var(--w-content);
    }
    .toc-m summary {
      cursor: pointer;
      padding: 0.7rem 1rem;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .toc-m ol {
      list-style: none;
      margin: 0;
      padding: 0.25rem 1rem 0.9rem;
    }
    .toc-m li + li {
      margin-top: 0.45rem;
    }
    .toc-m a {
      color: var(--ink-2);
      font-size: 0.9rem;
    }

    /* Wide: sticky sidebar left of the content column. */
    @media (min-width: 1150px) {
      .toc-m {
        display: none;
      }
      article.has-toc {
        display: grid;
        grid-template-columns: 13rem minmax(0, 1fr);
        column-gap: 3rem;
      }
      article.has-toc > .head,
      article.has-toc > .prose,
      article.has-toc > .series-nav {
        grid-column: 2;
      }
      .toc {
        display: block;
        grid-column: 1;
        grid-row: 1 / span 2;
      }
      .toc nav {
        position: sticky;
        top: 4.5rem;
        padding-top: 4rem;
      }
      .toc-label {
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-3);
        border-bottom: 1px solid var(--hairline);
        padding-bottom: 0.6rem;
      }
      .toc ol {
        list-style: none;
        margin: 0.9rem 0 0;
        padding: 0;
      }
      .toc li + li {
        margin-top: 0.55rem;
      }
      .toc a {
        display: block;
        font-size: 0.82rem;
        line-height: 1.4;
        color: var(--ink-2);
        border-left: 2px solid transparent;
        padding-left: 0.75rem;
        margin-left: -0.75rem;
        transition: color 0.2s ease, opacity 0.2s ease, border-color 0.2s ease;
      }
      .toc a:hover {
        color: var(--accent);
        text-decoration: none;
      }
      .toc a.is-past {
        color: var(--ink-3);
        opacity: 0.6;
      }
      .toc a.is-active {
        color: var(--accent);
        border-left-color: var(--accent);
      }
    }
  </style>

  <style is:global>
    /* Anchor jumps must clear the sticky header (smooth scroll is set globally). */
    .prose h2,
    .prose h3 {
      scroll-margin-top: 5.5rem;
    }
  </style>
</Base>
