---
import Base from '../layouts/Base.astro';
import ProjectCatalogCategory from './ProjectCatalogCategory.astro';
import { getProjectCatalog } from '../data/projectCatalog';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const catalog = getProjectCatalog(locale);
const title = `${catalog.title} — Canh-Trung Nguyen`;
const altPath = locale === 'en' ? '/vi/projects/' : '/projects/';
---

<Base locale={locale} title={title} description={catalog.description} altPath={altPath}>
  <section class="container catalog">
    <header class="page-head">
      <h1>{catalog.title}</h1>
      <p>{catalog.description}</p>
    </header>
    <div class="categories">
      {catalog.categories.map((category) => (
        <ProjectCatalogCategory category={category} locale={locale} labels={catalog.labels} />
      ))}
    </div>
  </section>
</Base>

<style>
  .catalog {
    padding-bottom: 2rem;
  }
  .page-head {
    max-width: var(--w-content);
    padding-top: 4rem;
  }
  .page-head h1 {
    font-size: clamp(2.2rem, 5vw, 3rem);
  }
  .page-head p {
    margin-top: 0.75rem;
    color: var(--ink-2);
  }
</style>
