---
import Base from '../layouts/Base.astro';
import HeroScene from './HeroScene.astro';
import ChapterArt from './ChapterArt.astro';
import ChapterIcon from './ChapterIcon.astro';
import CardRail, { type RailItem } from './CardRail.astro';
import { journey } from '../data/journey';
import { projects } from '../data/projects';
import { getProjectCatalog } from '../data/projectCatalog';
import { t, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = journey[locale];
// Newest first: reverse for display, keep original index for the chapter icon.
const chapters = c.chapters.map((ch, iconIndex) => ({ ch, iconIndex })).reverse();
// The die: one block per chapter, oldest first; the last chapter is current.
const dieBlocks = c.chapters.map((ch, i) => ({
  ch,
  n: i + 1,
  name: ch.title.split(' — ')[0],
  current: i === c.chapters.length - 1,
}));
const since = (years: string) => years.split(' — ')[0];

// Home rails: card name + animated art only. Order is editorial, not data order.
const programOrder = ['connected-driving', 'v2x-protocol-stack', 'robotics-sim2real', 'digital-twin-channel-sim'];
const programs: RailItem[] = programOrder
  .map((slug) => projects[locale].find((p) => p.slug === slug))
  .filter((p) => p !== undefined)
  .map((p) => ({ slug: p.slug, title: p.cardName, href: localePath(locale, `/projects/${p.slug}/`) }));
const independent: RailItem[] = (
  getProjectCatalog(locale).categories.find((cat) => cat.id === 'independent')?.entries ?? []
).flatMap((e) => {
  if (e.type !== 'independent') return [];
  const site = e.project.links.find((l) => l.label === 'Website') ?? e.project.links[0];
  return [{ slug: e.project.id, title: e.project.name, href: site.href, external: site.external }];
});
const title =
  locale === 'en'
    ? 'Canh-Trung Nguyen — FPGA, 5G, V2X & Digital Twins'
    : 'Nguyễn Cảnh Trung — FPGA, 5G, V2X & Digital Twin';
const altPath = locale === 'en' ? '/vi/' : '/';
---

<Base locale={locale} title={title} description={c.heroIntro} altPath={altPath}>
  <section class="hero">
    <div class="container hero-copy">
      <div class="die">
        <span class="pads" aria-hidden="true"></span>
        <div class="nm">
          <h1>{c.heroName}</h1>
          <p class="who mono">{c.heroRole}</p>
          <p class="tagline">{c.heroTagline}</p>
        </div>
        {
          dieBlocks.map(({ ch, n, name, current }) => (
            <a class:list={['blk', `t${n}`]} href={`#ch-${n}`} style={`grid-area: c${n}`}>
              <span class="code mono">
                {ch.era} ·{' '}
                {current ? (
                  <>
                    {since(ch.years)} — <span class="now"><i aria-hidden="true" />{t(locale, 'hero.now')}</span>
                  </>
                ) : (
                  ch.years
                )}
              </span>
              <b>{name}</b>
            </a>
          ))
        }
      </div>
      <div class="intro-row">
        <p class="intro">{c.heroIntro}</p>
        <div class="go">
          <a class="cta mono" href="#journey">{t(locale, 'hero.cta')} <span class="arrow">↓</span></a>
        </div>
      </div>
    </div>
    <div class="scene">
      <HeroScene />
    </div>
  </section>

  <section class="journey container">
    <h2 class="section-label mono" id="journey">{c.journeyLabel}</h2>
    <ol class="chapters">
      {
        chapters.map(({ ch, iconIndex }) => (
          <li class="chapter" id={`ch-${iconIndex + 1}`}>
            <div class="art" aria-hidden="true">
              <ChapterArt index={iconIndex} />
            </div>
            <span class="dot" aria-hidden="true" />
            <div class="body">
              <p class="era mono">
                {ch.era} <span class="years">{ch.years}</span>
              </p>
              <h3>
                <ChapterIcon index={iconIndex} />
                {ch.title}
              </h3>
              <p class="org">{ch.org}</p>
              <ul class="story" role="list">
                {ch.story.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
              <ul class="metrics" role="list">
                {ch.metrics.map((m) => (
                  <li class="mono">{m}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <CardRail locale={locale} label={c.currentLabel} items={programs} />
  {independent.length > 0 && <CardRail locale={locale} label={c.independentLabel} items={independent} />}
</Base>

<style>
  /* Full-viewport hero. The copy centres in the "sky" above the panorama
     and the panorama tucks up behind it, so the two read as one scene
     instead of two blocks with a void between them. */
  .hero {
    /* Exactly one screen: on landing the visitor sees the hero and nothing
       of the timeline — the journey is reached by the CTA or by scrolling.
       Never cap this height; a cap lets the next section peek above the fold. */
    min-height: calc(100svh - 4.2rem);
    display: flex;
    flex-direction: column;
  }
  .hero-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: clamp(10px, 2.5vh, 32px);
    padding-bottom: clamp(0.5rem, 3vh, 2.5rem);
    /* A flex item with auto inline margins shrinks to fit and centres itself,
       drifting off the page frame — force it to fill the 62rem container so
       the copy shares its left edge with the journey below. */
    width: 100%;
  }
  /* ---- The die: the career as a chip floorplan. Name cell + one block per
     chapter; tone deepens with time and the current chapter carries the
     accent, a double frame and a live "now" marker. */
  .die {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 14px;
    border: 1px solid color-mix(in oklch, var(--ink-3) 70%, var(--bg));
    outline: 1px solid color-mix(in oklch, var(--hairline) 80%, var(--bg));
    outline-offset: 6px;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows:
      minmax(clamp(64px, 11vh, 120px), auto)
      minmax(clamp(40px, 6vh, 64px), auto)
      minmax(clamp(84px, 13vh, 128px), auto);
    grid-template-areas:
      'nm nm nm nm nm nm nm c5 c5 c5 c5 c5'
      'nm nm nm nm nm nm nm c5 c5 c5 c5 c5'
      'c1 c1 c1 c2 c2 c2 c2 c3 c3 c4 c4 c4';
  }
  /* Bond pads around the seal ring. */
  .pads {
    position: absolute;
    inset: -13px;
    pointer-events: none;
    opacity: 0.4;
    --pad: repeating-linear-gradient(90deg, var(--ink-3) 0 5px, transparent 5px 22px);
    --padv: repeating-linear-gradient(0deg, var(--ink-3) 0 5px, transparent 5px 22px);
    background:
      var(--pad) top / 100% 3px no-repeat,
      var(--pad) bottom / 100% 3px no-repeat,
      var(--padv) left / 3px 100% no-repeat,
      var(--padv) right / 3px 100% no-repeat;
  }
  .nm {
    grid-area: nm;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 6px 8px 4px;
  }
  /* The name keeps the literary serif at text optical size. */
  h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.12;
    font-size: clamp(2.6rem, min(5.6vw, 8.6vh), 4.6rem);
  }
  .who {
    margin-top: 14px;
    font-size: 0.8rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .tagline {
    margin-top: 8px;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--ink-2);
  }
  .blk {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2px;
    padding: 10px 12px;
    color: var(--ink);
    border: 1px solid color-mix(in oklch, var(--accent) 18%, var(--hairline));
    transition: background-color 0.25s, border-color 0.25s;
  }
  .blk:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .blk::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.05;
    pointer-events: none;
  }
  .blk > * {
    position: relative;
  }
  .blk .code {
    margin-bottom: auto;
    font-size: 0.7rem;
    line-height: 1.3;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  /* Die labels read like a floorplan/EDA view: code font, not display. */
  .blk b {
    font: 400 clamp(0.82rem, 1.1vw, 0.95rem) / 1.25 var(--font-mono);
    letter-spacing: -0.01em;
    color: var(--ink-2);
  }
  .blk:not(.t5):hover {
    background: color-mix(in oklch, var(--accent) 24%, var(--surface));
  }
  .blk:not(.t5):hover b {
    color: var(--ink);
  }
  /* Past chapters recede: a shallow ramp and a different hatch each. */
  .t1 { background: color-mix(in oklch, var(--accent) 3%, var(--surface)); }
  .t2 { background: color-mix(in oklch, var(--accent) 6%, var(--surface)); }
  .t3 { background: color-mix(in oklch, var(--accent) 10%, var(--surface)); }
  .t4 { background: color-mix(in oklch, var(--accent) 15%, var(--surface)); }
  :global([data-theme='dark']) .t1 { background: color-mix(in oklch, var(--accent) 4%, var(--surface)); }
  :global([data-theme='dark']) .t2 { background: color-mix(in oklch, var(--accent) 7%, var(--surface)); }
  :global([data-theme='dark']) .t4 { background: color-mix(in oklch, var(--accent) 14%, var(--surface)); }
  .t1::before { background: repeating-linear-gradient(90deg, var(--ink) 0 1px, transparent 1px 6px); }
  .t2::before { background: repeating-linear-gradient(0deg, var(--ink) 0 1px, transparent 1px 6px); }
  .t3::before { background: repeating-linear-gradient(45deg, var(--ink) 0 1px, transparent 1px 7px); }
  .t4::before { background: radial-gradient(var(--ink) 1px, transparent 1.3px) 0 0 / 6px 6px; }
  /* Current chapter: the only accent area on the page. */
  .t5 {
    color: var(--bg);
    background: color-mix(in oklch, var(--accent) 88%, var(--surface));
    border: 2px solid var(--accent);
    outline: 1px solid color-mix(in oklch, var(--accent) 45%, var(--surface));
    outline-offset: 3px;
  }
  .t5::before {
    background: repeating-linear-gradient(-45deg, var(--bg) 0 1px, transparent 1px 8px);
    opacity: 0.14;
  }
  .t5 .code {
    color: color-mix(in oklch, var(--bg) 78%, var(--accent));
  }
  .t5 b {
    color: inherit;
    font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    font-weight: 700;
  }
  :global([data-theme='dark']) .t5 {
    color: var(--ink);
    background: color-mix(in oklch, var(--accent) 58%, var(--surface));
  }
  :global([data-theme='dark']) .t5 .code {
    color: color-mix(in oklch, var(--ink) 85%, var(--accent));
  }
  :global([data-theme='dark']) .t5::before {
    background: repeating-linear-gradient(-45deg, var(--ink) 0 1px, transparent 1px 8px);
    opacity: 0.07;
  }
  .now {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .now i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .now i {
      animation: now-pulse 2.4s ease-out infinite;
    }
  }
  @keyframes now-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in oklch, currentColor 60%, transparent); }
    70%, 100% { box-shadow: 0 0 0 7px transparent; }
  }

  /* ---- Intro on the die's 12-column grid: bio under the name, CTA under
     the current chapter. */
  .intro-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0 8px;
    padding-inline: 15px;
    margin-top: clamp(36px, 7vh, 72px);
    align-items: center;
  }
  .intro {
    grid-column: 1 / 8;
    padding-left: 8px;
    padding-right: clamp(8px, 3vw, 40px);
    font-size: clamp(0.98rem, 1.9vh, 1.08rem);
    line-height: 1.6;
    max-width: 62ch;
  }
  .go {
    grid-column: 8 / 13;
    padding-left: 12px;
  }
  .cta {
    display: inline-block;
    padding: 0.7rem 1.2rem;
    border: 1px solid color-mix(in oklch, var(--ink) 55%, var(--bg));
    outline: 1px solid var(--hairline);
    outline-offset: 3px;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .cta:hover {
    text-decoration: none;
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .cta .arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .cta:hover .arrow {
    transform: translateY(3px);
  }
  @media (max-width: 760px) {
    .die {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      grid-auto-rows: minmax(48px, auto);
      grid-template-areas: 'nm nm' 'c5 c5' 'c4 c3' 'c2 c1';
      gap: 5px;
      padding: 8px;
    }
    .nm {
      padding-bottom: 8px;
    }
    h1 {
      font-size: clamp(2.2rem, 10.5vw, 2.8rem);
    }
    .who {
      margin-top: 10px;
      font-size: 0.76rem;
    }
    .tagline {
      margin-top: 6px;
      font-size: 0.95rem;
    }
    .blk {
      padding: 8px 10px;
    }
    .blk .code {
      font-size: 0.64rem;
    }
    .blk b {
      font-size: 0.8rem;
    }
    .t5 b {
      font-size: 1.05rem;
    }
    .intro-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 26px;
      padding-inline: 0;
      margin-top: 40px;
    }
    .intro,
    .go {
      grid-column: 1;
      padding: 0;
    }
    .intro {
      font-size: 0.94rem;
      line-height: 1.5;
    }
  }
  @media (max-height: 760px) and (min-width: 761px) {
    h1 {
      font-size: clamp(2rem, 7.6vh, 4rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blk,
    .cta,
    .cta .arrow {
      transition: none;
    }
  }

  .scene {
    /* The panorama lives in the same 62rem frame as the copy and the journey:
       its ground line ends where the section hairlines end. */
    width: 100%;
    max-width: var(--w-wide);
    margin-inline: auto;
    padding-inline: 1.25rem;
    flex-shrink: 0;
  }
  /* Full width at its natural ratio, like the journey art; only wide-and-short
     screens cap its height (never below 150px) so the hero stays one screen. */
  .scene :global(.hero-scene) {
    max-height: max(25vh, 150px);
  }
  /* The drawing's top third is empty sky — let it rise behind the copy. */
  @media (min-width: 900px) {
    .scene {
      margin-top: clamp(-7rem, -8vh, -2rem);
    }
  }
  @media (max-width: 760px) {
    .scene {
      margin-top: -5vw;
    }
  }

  .section-label {
    scroll-margin-top: 5rem;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 0.6rem;
    margin: 5rem 0 0;
  }

  .chapters {
    list-style: none;
    margin: 0;
    padding: 1rem 0 0;
  }
  /* Square-wave timeline: the dashed line runs down the outer edge of each
     spread — left for odd chapters, right for even — then crosses the full
     width to the other side, enclosing art and text like a clock signal. */
  .chapter {
    scroll-margin-top: 4rem;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 3rem;
    align-items: center;
    padding: 2.5rem 3rem 3.25rem;
  }
  .chapter::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    border-left: 1px dashed var(--ink-3);
    opacity: 0.5;
  }
  .chapter::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    border-top: 1px dashed var(--ink-3);
    opacity: 0.5;
  }
  .chapter:first-child::before {
    top: 2.7rem;
  }
  .chapter:last-child::after {
    display: none;
  }
  .body {
    grid-column: 1;
    grid-row: 1;
    max-width: var(--w-content);
  }
  .art {
    grid-column: 2;
    grid-row: 1;
    max-width: 30rem;
    width: 100%;
    justify-self: start;
  }
  .chapter:nth-child(even)::before {
    left: auto;
    right: 0;
  }
  .chapter:nth-child(even) .body {
    grid-column: 2;
  }
  .chapter:nth-child(even) .art {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
  }
  .dot {
    position: absolute;
    top: 2.7rem;
    left: 0;
    transform: translate(-50%, -50%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .chapter:nth-child(even) .dot {
    left: auto;
    right: 0;
    transform: translate(50%, -50%);
  }
  @media (max-width: 900px) {
    /* Reading order on small screens: era + title + org, then the art,
       then bullets and chips. The body dissolves (display: contents) so
       its children can be reordered around the art. */
    .chapter,
    .chapter:nth-child(even) {
      display: flex;
      flex-direction: column;
      align-items: stretch; /* desktop rule centres items; undo it here */
      padding: 0.5rem 0 2rem 1.5rem;
    }
    .body {
      display: contents;
    }
    .era { order: 1; margin-top: 1rem; }
    .chapter h3 { order: 2; }
    .org { order: 3; }
    .art { order: 4; }
    .story { order: 5; margin-top: 0; }
    .metrics { order: 6; }
    /* One continuous left spine on small screens — no room for the wave. */
    .chapter:nth-child(even)::before {
      left: 0;
      right: auto;
    }
    .chapter::after {
      display: none;
    }
    .chapter:nth-child(even) .dot {
      left: 0;
      right: auto;
      transform: translate(-50%, -50%);
    }
    .dot {
      top: 1.6rem;
    }
    .chapter:first-child::before {
      top: 1.6rem;
    }
    .art,
    .chapter:nth-child(even) .art {
      max-width: 24rem;
      margin: 1rem 0 0;
    }
    .body {
      padding: 0.8rem 0 0;
    }
  }
  .era {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  .years {
    color: var(--ink-3);
    margin-left: 0.5rem;
  }
  .chapter h3 {
    font-size: 1.8rem;
    margin-top: 0.35rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .org {
    color: var(--ink-2);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }
  .story {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .story li {
    position: relative;
    padding-left: 1.2rem;
    margin-top: 0.55rem;
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .story li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .metrics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.25rem 0 0;
  }
  .metrics li {
    font-size: 0.72rem;
    color: var(--ink-2);
    background: var(--code-bg);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
  }

</style>
