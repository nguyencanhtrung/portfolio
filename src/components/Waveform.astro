---
// Decorative I/Q-style waveform, generated at build time. Pure SVG, no JS.
const W = 900;
const H = 120;
const N = 360;
const mid = H / 2;

function trace(f1: number, f2: number, a1: number, a2: number, phase: number) {
  const pts: string[] = [];
  for (let i = 0; i <= N; i++) {
    const x = (i / N) * W;
    const tt = (i / N) * Math.PI * 2;
    const y =
      mid +
      a1 * Math.sin(f1 * tt + phase) +
      a2 * Math.sin(f2 * tt + phase * 1.7) * Math.sin(0.5 * tt);
    pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
  }
  return pts.join(' ');
}

const i_trace = trace(4, 13, 26, 12, 0);
const q_trace = trace(4, 13, 26, 12, Math.PI / 2);
---

<svg
  class="waveform"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <line x1="0" y1={mid} x2={W} y2={mid} class="axis"></line>
  <polyline points={q_trace} class="q"></polyline>
  <polyline points={i_trace} class="i"></polyline>
</svg>

<style>
  .waveform {
    display: block;
    width: 100%;
    height: 7.5rem;
  }
  .axis {
    stroke: var(--hairline);
    stroke-width: 1;
  }
  polyline {
    fill: none;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .i {
    stroke: var(--accent);
    opacity: 0.85;
  }
  .q {
    stroke: var(--ink-3);
    opacity: 0.45;
  }
</style>
