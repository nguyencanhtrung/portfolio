---
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Citations are the same in both languages; only the section label is localised.
const publications = [
  {
    authors: ['Thanh Phung Truong', 'Hieu Hoang Van', 'Trung Nguyen Canh', 'Hieu V. Nguyen', 'Sungrae Cho'],
    title: 'Reinforcement Learning for RAN Intelligent Controller: A Case Study on Traffic Steering',
    venue:
      'Intelligence of Things: Technologies and Applications, Lecture Notes on Data Engineering and Communications Technologies, Springer, 2026, pp. 31–42',
    href: 'https://doi.org/10.1007/978-3-032-13254-3_3',
  },
  {
    authors: ['Trung Nguyen Canh', 'Hieu Hoang Van', 'Trang Cao Minh', 'Russ Klein'],
    title: 'Fast, Efficient 5G with High-Level Synthesis',
    venue:
      'Proceedings of the Wireless Congress 2023: Systems & Applications, Munich, ISBN 978-3-645-50196-5',
  },
];
const me = 'Trung Nguyen Canh';

const content = {
  en: {
    title: 'About',
    heading: 'About me',
    paras: [
      'I’m Canh-Trung Nguyen, an engineer based in Hanoi, Vietnam. I started my career in FPGA design—building 5G physical-layer channels at hundreds of megahertz, digital front-ends engineered to meet 3GPP spectrum masks, and HLS image-processing accelerators, before moving into full O-RAN radio bring-up.',
      'Today, I manage the Verticals Group at SoC.one—30 engineers working across physical AI, automotive, drones, and 5G/6G—while remaining hands-on as tech lead for our core programs in C-V2X sidelink, connected driving digital twins, and sim-to-real robotics. Across all of these, the hardest part is the same: making sure simulated models actually hold up against real-world physics and hardware constraints.',
      'Views expressed here are my own; descriptions of current work are kept strictly to public technologies and industry standards.',
    ],
    eduLabel: 'Education',
    edu: [
      'M.S. Electrical & Computer Engineering — TU Kaiserslautern, Germany (Embedded Computing Systems)',
      'B.Eng. Electrical & Electronics Engineering — Hanoi University of Science and Technology (Microelectronics)',
    ],
    pubLabel: 'Publications',
  },
  vi: {
    title: 'Giới thiệu',
    heading: 'Về tôi',
    paras: [
      'Tôi là Nguyễn Cảnh Trung, một kỹ sư làm việc tại Hà Nội. Tôi khởi đầu sự nghiệp từ mảng thiết kế FPGA — xây dựng các kênh lớp vật lý 5G chạy ở xung nhịp hàng trăm megahertz, các khối digital front-end đạt chuẩn mặt nạ phổ 3GPP và những bộ tăng tốc xử lý ảnh bằng HLS — trước khi chuyển sang trực tiếp bring-up trọn bộ hệ thống vô tuyến O-RAN.',
      'Hiện tại, tôi quản lý Verticals Group tại SoC.one với đội ngũ 30 kỹ sư làm việc trải rộng trên các mảng physical AI, công nghệ ô tô, drone và 5G/6G, đồng thời vẫn trực tiếp làm kỹ thuật ở vai trò tech lead cho các chương trình trọng điểm về C-V2X sidelink, digital twin cho xe kết nối và robotics sim-to-real. Ở tất cả các mảng này, phần khó nhất đều nằm ở một điểm: làm sao để mô hình mô phỏng thực sự trụ vững trước các quy luật vật lý và giới hạn phần cứng ngoài đời thực.',
      'Mọi quan điểm chia sẻ trên trang này đều mang tính cá nhân; phần mô tả về công việc hiện tại chỉ dừng ở phạm vi các công nghệ công khai và tiêu chuẩn chung của ngành.',
    ],
    eduLabel: 'Học vấn',
    edu: [
      'Thạc sĩ Kỹ thuật Điện & Máy tính — TU Kaiserslautern, Đức (chuyên ngành Hệ thống máy tính nhúng)',
      'Kỹ sư Kỹ thuật Điện – Điện tử — Đại học Bách khoa Hà Nội (chuyên ngành Vi điện tử)',
    ],
    pubLabel: 'Công bố khoa học',
  },
}[locale];

const altPath = locale === 'en' ? '/vi/about/' : '/about/';
---

<Base
  locale={locale}
  title={`${content.title} — Canh-Trung Nguyen`}
  description={content.paras[0]}
  altPath={altPath}
>
  <section class="container">
    <header class="page-head">
      <h1>{content.heading}</h1>
    </header>
    <div class="prose">
      {content.paras.map((p) => <p>{p}</p>)}
      <h2>{content.eduLabel}</h2>
      <ul>
        {content.edu.map((e) => <li>{e}</li>)}
      </ul>
      <h2>{content.pubLabel}</h2>
      <ul class="pubs">
        {
          publications.map((p) => (
            <li>
              {p.authors.map((a, i) => (
                <>{i > 0 && ', '}{a === me ? <strong>{a}</strong> : a}</>
              ))}{', “'}{p.href ? <a href={p.href} rel="noopener">{p.title}</a> : p.title}{'”, '}
              <em>{p.venue}</em>.
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-top: 4rem;
  }
  .page-head h1 {
    font-size: clamp(2.2rem, 5vw, 3rem);
  }
  .prose {
    margin-top: 2rem;
  }
  .pubs li {
    margin-top: 0.6rem;
    line-height: 1.6;
  }
</style>
