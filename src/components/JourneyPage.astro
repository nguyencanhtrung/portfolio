---
import Base from '../layouts/Base.astro';
import HeroScene from './HeroScene.astro';
import ChapterArt from './ChapterArt.astro';
import ChapterIcon from './ChapterIcon.astro';
import ProjectArt from './ProjectArt.astro';
import { journey } from '../data/journey';
import { projects } from '../data/projects';
import { t, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = journey[locale];
// Newest first: reverse for display, keep original index for the chapter icon.
const chapters = c.chapters.map((ch, iconIndex) => ({ ch, iconIndex })).reverse();
const projectCards = projects[locale];
const title =
  locale === 'en'
    ? 'Canh-Trung Nguyen — FPGA, 5G, V2X & Digital Twins'
    : 'Nguyễn Cảnh Trung — FPGA, 5G, V2X & Digital Twin';
const altPath = locale === 'en' ? '/vi/' : '/';
---

<Base locale={locale} title={title} description={c.heroIntro} altPath={altPath}>
  <section class="hero">
    <div class="container hero-copy">
      <div class="hero-grid">
        <div class="name-col">
          <h1>{c.heroName}</h1>
          <p class="tagline">{c.heroTagline}</p>
        </div>
        <div class="say-col">
          <p class="intro">{c.heroIntro}</p>
          <p class="role mono">{c.heroRole}</p>
          <a class="cta mono" href="#journey">{t(locale, 'hero.cta')} <span class="arrow">↓</span></a>
        </div>
      </div>
    </div>
    <div class="scene">
      <HeroScene />
    </div>
  </section>

  <section class="journey container">
    <h2 class="section-label mono" id="journey">{c.journeyLabel}</h2>
    <ol class="chapters">
      {
        chapters.map(({ ch, iconIndex }) => (
          <li class="chapter">
            <div class="art" aria-hidden="true">
              <ChapterArt index={iconIndex} />
            </div>
            <span class="dot" aria-hidden="true" />
            <div class="body">
              <p class="era mono">
                {ch.era} <span class="years">{ch.years}</span>
              </p>
              <h3>
                <ChapterIcon index={iconIndex} />
                {ch.title}
              </h3>
              <p class="org">{ch.org}</p>
              <ul class="story" role="list">
                {ch.story.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
              <ul class="metrics" role="list">
                {ch.metrics.map((m) => (
                  <li class="mono">{m}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="current container">
    <h2 class="section-label mono">{c.currentLabel}</h2>
    <div class="cards">
      {
        projectCards.map((p) => (
          <a class="card" href={localePath(locale, `/projects/${p.slug}/`)}>
            <div class="card-art">
              <ProjectArt slug={p.slug} />
            </div>
            <h3>{p.name}</h3>
            <p>{p.oneLiner}</p>
            <span class="more mono">→</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /* Full-viewport hero. The copy centres in the "sky" above the panorama
     and the panorama tucks up behind it, so the two read as one scene
     instead of two blocks with a void between them. */
  .hero {
    /* Exactly one screen: on landing the visitor sees the hero and nothing
       of the timeline — the journey is reached by the CTA or by scrolling.
       Never cap this height; a cap lets the next section peek above the fold. */
    min-height: calc(100svh - 4.2rem);
    display: flex;
    flex-direction: column;
  }
  .hero-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 1.5rem;
    /* Sit above the optical centre: dead-centre copy reads as floating. */
    padding-bottom: clamp(1rem, 6vh, 5rem);
    /* A flex item with auto inline margins shrinks to fit and centres itself,
       drifting off the page frame — force it to fill the 62rem container so
       the copy shares its left edge with the journey below. */
    width: 100%;
  }
  /* Name left, explanation right — the copy fills the same frame as the
     panorama and the timeline instead of stopping two thirds across.
     Below 900px it stacks, keeping the reading order of the markup. */
  .hero-grid {
    display: grid;
    gap: 2.5rem 3rem;
  }
  .name-col,
  .say-col {
    max-width: var(--w-content);
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
    }
    .name-col,
    .say-col {
      max-width: none;
    }
  }
  .cta {
    display: inline-block;
    align-self: flex-start;
    margin-top: 1.75rem;
    padding: 0.65rem 1.3rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .cta:hover {
    text-decoration: none;
    border-color: var(--accent);
    color: var(--accent);
  }
  .cta .arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .cta:hover .arrow {
    transform: translateY(3px);
  }
  .scene {
    /* The panorama lives in the same 62rem frame as the copy and the journey:
       its ground line ends where the section hairlines end. */
    width: 100%;
    max-width: var(--w-wide);
    margin-inline: auto;
    padding-inline: 1.25rem;
    flex-shrink: 0;
  }
  /* The drawing's top third is empty sky — let it rise behind the CTA
     so the copy stands on the scene. Skip on small screens where the
     scaled-down sky band is too shallow to clear the text. */
  @media (min-width: 900px) {
    .scene {
      margin-top: clamp(-7rem, -8vh, -2rem);
    }
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.2rem);
  }
  .tagline {
    font-family: var(--font-serif);
    font-variation-settings: 'opsz' 40;
    font-style: italic;
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    color: var(--ink-2);
    margin: 0.75rem 0 0;
  }
  .intro {
    font-size: 1.1rem;
  }
  .role {
    margin-top: 1.25rem;
    color: var(--accent);
    font-size: 0.75rem;
    text-wrap: balance;
  }

  .section-label {
    scroll-margin-top: 5rem;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 0.6rem;
    margin: 5rem 0 0;
  }

  .chapters {
    list-style: none;
    margin: 0;
    padding: 1rem 0 0;
  }
  /* Square-wave timeline: the dashed line runs down the outer edge of each
     spread — left for odd chapters, right for even — then crosses the full
     width to the other side, enclosing art and text like a clock signal. */
  .chapter {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 3rem;
    align-items: center;
    padding: 2.5rem 3rem 3.25rem;
  }
  .chapter::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    border-left: 1px dashed var(--ink-3);
    opacity: 0.5;
  }
  .chapter::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    border-top: 1px dashed var(--ink-3);
    opacity: 0.5;
  }
  .chapter:first-child::before {
    top: 2.7rem;
  }
  .chapter:last-child::after {
    display: none;
  }
  .body {
    grid-column: 1;
    grid-row: 1;
    max-width: var(--w-content);
  }
  .art {
    grid-column: 2;
    grid-row: 1;
    max-width: 30rem;
    width: 100%;
    justify-self: start;
  }
  .chapter:nth-child(even)::before {
    left: auto;
    right: 0;
  }
  .chapter:nth-child(even) .body {
    grid-column: 2;
  }
  .chapter:nth-child(even) .art {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
  }
  .dot {
    position: absolute;
    top: 2.7rem;
    left: 0;
    transform: translate(-50%, -50%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .chapter:nth-child(even) .dot {
    left: auto;
    right: 0;
    transform: translate(50%, -50%);
  }
  @media (max-width: 900px) {
    /* Reading order on small screens: era + title + org, then the art,
       then bullets and chips. The body dissolves (display: contents) so
       its children can be reordered around the art. */
    .chapter,
    .chapter:nth-child(even) {
      display: flex;
      flex-direction: column;
      align-items: stretch; /* desktop rule centres items; undo it here */
      padding: 0.5rem 0 2rem 1.5rem;
    }
    .body {
      display: contents;
    }
    .era { order: 1; margin-top: 1rem; }
    .chapter h3 { order: 2; }
    .org { order: 3; }
    .art { order: 4; }
    .story { order: 5; margin-top: 0; }
    .metrics { order: 6; }
    /* One continuous left spine on small screens — no room for the wave. */
    .chapter:nth-child(even)::before {
      left: 0;
      right: auto;
    }
    .chapter::after {
      display: none;
    }
    .chapter:nth-child(even) .dot {
      left: 0;
      right: auto;
      transform: translate(-50%, -50%);
    }
    .dot {
      top: 1.6rem;
    }
    .chapter:first-child::before {
      top: 1.6rem;
    }
    .art,
    .chapter:nth-child(even) .art {
      max-width: 24rem;
      margin: 1rem 0 0;
    }
    .body {
      padding: 0.8rem 0 0;
    }
  }
  .era {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  .years {
    color: var(--ink-3);
    margin-left: 0.5rem;
  }
  .chapter h3 {
    font-size: 1.8rem;
    margin-top: 0.35rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .org {
    color: var(--ink-2);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }
  .story {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .story li {
    position: relative;
    padding-left: 1.2rem;
    margin-top: 0.55rem;
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .story li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .metrics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.25rem 0 0;
  }
  .metrics li {
    font-size: 0.72rem;
    color: var(--ink-2);
    background: var(--code-bg);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 700px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .card {
    position: relative;
    display: block;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    padding: 1.4rem 1.5rem 2.4rem;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card-art {
    border-bottom: 1px solid var(--hairline);
    margin: -0.4rem 0 1rem;
    padding-bottom: 0.5rem;
  }
  .card h3 {
    font-size: 1.15rem;
  }
  .card p {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .more {
    position: absolute;
    right: 1.25rem;
    bottom: 1rem;
    color: var(--accent);
  }
</style>
