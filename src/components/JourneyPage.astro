---
import Base from '../layouts/Base.astro';
import HeroScene from './HeroScene.astro';
import ChapterIcon from './ChapterIcon.astro';
import ProjectArt from './ProjectArt.astro';
import { journey } from '../data/journey';
import { projects } from '../data/projects';
import { t, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = journey[locale];
// Newest first: reverse for display, keep original index for the chapter icon.
const chapters = c.chapters.map((ch, iconIndex) => ({ ch, iconIndex })).reverse();
const projectCards = projects[locale];
const title =
  locale === 'en'
    ? 'Canh-Trung Nguyen — FPGA, 5G, V2X & Digital Twins'
    : 'Nguyễn Cảnh Trung — FPGA, 5G, V2X & Digital Twin';
const altPath = locale === 'en' ? '/vi/' : '/';
---

<Base locale={locale} title={title} description={c.heroIntro} altPath={altPath}>
  <section class="hero">
    <div class="container hero-copy">
      <p class="kicker mono">{c.heroKicker}</p>
      <h1>{c.heroName}</h1>
      <p class="tagline">{c.heroTagline}</p>
      <p class="intro">{c.heroIntro}</p>
      <p class="role mono">{c.heroRole}</p>
      <a class="cta mono" href="#journey">{t(locale, 'hero.cta')} <span class="arrow">↓</span></a>
    </div>
    <div class="scene">
      <HeroScene />
    </div>
  </section>

  <section class="journey container">
    <h2 class="section-label mono" id="journey">{c.journeyLabel}</h2>
    <ol class="chapters">
      {
        chapters.map(({ ch, iconIndex }) => (
          <li class="chapter">
            <div class="marker" aria-hidden="true">
              <span class="dot" />
            </div>
            <div class="body">
              <p class="era mono">
                {ch.era} <span class="years">{ch.years}</span>
              </p>
              <h3>
                <ChapterIcon index={iconIndex} />
                {ch.title}
              </h3>
              <p class="org">{ch.org}</p>
              {ch.story.map((par) => (
                <p class="story">{par}</p>
              ))}
              <ul class="metrics" role="list">
                {ch.metrics.map((m) => (
                  <li class="mono">{m}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="current container">
    <h2 class="section-label mono">{c.currentLabel}</h2>
    <div class="cards">
      {
        projectCards.map((p) => (
          <a class="card" href={localePath(locale, `/projects/${p.slug}/`)}>
            <div class="card-art">
              <ProjectArt slug={p.slug} />
            </div>
            <h3>{p.name}</h3>
            <p>{p.oneLiner}</p>
            <span class="more mono">→</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /* Full-viewport hero. The copy centres in the "sky" above the panorama
     and the panorama tucks up behind it, so the two read as one scene
     instead of two blocks with a void between them. */
  .hero {
    min-height: calc(100svh - 4.2rem);
    display: flex;
    flex-direction: column;
  }
  .hero-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 1.5rem;
    max-width: none;
  }
  .hero-copy > * {
    max-width: var(--w-content);
  }
  .cta {
    display: inline-block;
    align-self: flex-start;
    margin-top: 1.75rem;
    padding: 0.65rem 1.3rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .cta:hover {
    text-decoration: none;
    border-color: var(--accent);
    color: var(--accent);
  }
  .cta .arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .cta:hover .arrow {
    transform: translateY(3px);
  }
  .scene {
    width: 100%;
    flex-shrink: 0;
    overflow: hidden;
  }
  /* The drawing's top third is empty sky — let it rise behind the CTA
     so the copy stands on the scene. Skip on small screens where the
     scaled-down sky band is too shallow to clear the text. */
  @media (min-width: 900px) {
    .scene {
      margin-top: clamp(-7rem, -8vh, -2rem);
    }
  }
  .kicker {
    color: var(--ink-3);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    margin-bottom: 1.25rem;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.2rem);
  }
  .tagline {
    font-family: var(--font-serif);
    font-variation-settings: 'opsz' 40;
    font-style: italic;
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    color: var(--ink-2);
    margin: 0.75rem 0 2rem;
  }
  .intro {
    margin-top: 1.25rem;
    font-size: 1.1rem;
  }
  .role {
    margin-top: 1.25rem;
    color: var(--accent);
    font-size: 0.8rem;
  }

  .section-label {
    scroll-margin-top: 5rem;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 0.6rem;
    margin: 5rem 0 0;
  }

  .chapters {
    list-style: none;
    margin: 0;
    padding: 1rem 0 0;
  }
  .chapter {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 1rem;
  }
  .marker {
    position: relative;
  }
  .marker::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--hairline);
  }
  .chapter:last-child .marker::before {
    bottom: auto;
    height: 2.4rem;
  }
  .dot {
    position: absolute;
    left: 50%;
    top: 2rem;
    transform: translateX(-50%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .body {
    padding: 1.6rem 0 2.4rem;
    max-width: var(--w-content);
  }
  .era {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  .years {
    color: var(--ink-3);
    margin-left: 0.5rem;
  }
  .chapter h3 {
    font-size: 1.8rem;
    margin-top: 0.35rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .org {
    color: var(--ink-2);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }
  .story {
    margin-top: 1rem;
  }
  .metrics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.25rem 0 0;
  }
  .metrics li {
    font-size: 0.72rem;
    color: var(--ink-2);
    background: var(--code-bg);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 700px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .card {
    position: relative;
    display: block;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    padding: 1.4rem 1.5rem 2.4rem;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card-art {
    border-bottom: 1px solid var(--hairline);
    margin: -0.4rem 0 1rem;
    padding-bottom: 0.5rem;
  }
  .card h3 {
    font-size: 1.15rem;
  }
  .card p {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .more {
    position: absolute;
    right: 1.25rem;
    bottom: 1rem;
    color: var(--accent);
  }
</style>
