---
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Citations are the same in both languages; only the section label is localised.
const publications = [
  {
    authors: ['Thanh Phung Truong', 'Hieu Hoang Van', 'Trung Nguyen Canh', 'Hieu V. Nguyen', 'Sungrae Cho'],
    title: 'Reinforcement Learning for RAN Intelligent Controller: A Case Study on Traffic Steering',
    venue:
      'Intelligence of Things: Technologies and Applications, Lecture Notes on Data Engineering and Communications Technologies, Springer, 2026, pp. 31–42',
    href: 'https://doi.org/10.1007/978-3-032-13254-3_3',
  },
  {
    authors: ['Trung Nguyen Canh', 'Hieu Hoang Van', 'Trang Cao Minh', 'Russ Klein'],
    title: 'Fast, Efficient 5G with High-Level Synthesis',
    venue:
      'Proceedings of the Wireless Congress 2023: Systems & Applications, Munich, ISBN 978-3-645-50196-5',
  },
];
const me = 'Trung Nguyen Canh';

const content = {
  en: {
    title: 'About',
    heading: 'About me',
    paras: [
      'I’m Canh-Trung Nguyen — an engineer from Vietnam who has spent my career at the line where hardware meets systems. I started in FPGA design: 5G physical-layer channels closing timing at hundreds of megahertz, digital front-ends meeting 3GPP spectrum masks, and image-processing accelerators in HLS.',
      'Today, I manage the Verticals Group at SoC.one — teams working across robotics, automotive, drones, and 5G/6G — while staying hands-on as tech lead for its key programs: connected driving (C-V2X sidelink), V2X protocol stacks, digital twins with ray-traced radio channels, and sim-to-real robotics. The common thread: systems where the computed world has to agree with the physical one — and teams that need both rigor and momentum.',
      'This site is the story of that path, plus a blog where I share perspectives on connected driving, robotics, and AI. Opinions here are my own; current work is described only at the level of public technologies and standards.',
    ],
    eduLabel: 'Education',
    edu: [
      'M.S. Electrical & Computer Engineering — TU Kaiserslautern, Germany (Embedded Computing Systems)',
      'B.Eng. Electrical & Electronics Engineering — Hanoi University of Science and Technology (Microelectronics)',
    ],
    pubLabel: 'Publications',
    contactLabel: 'Get in touch',
    contact:
      'The fastest way to reach me is email. I’m also on GitHub and LinkedIn.',
  },
  vi: {
    title: 'Giới thiệu',
    heading: 'Về tôi',
    paras: [
      'Tôi là Nguyễn Cảnh Trung — một kỹ sư đến từ Hải Phòng - Hạ Long. Tôi khởi đầu sự nghiệp với mảng thiết kế FPGA: từ các kênh lớp vật lý 5G đạt timing closure ở hàng trăm megahertz, digital front-end đáp ứng spectrum mask 3GPP, cho đến các accelerator xử lý ảnh viết bằng HLS.',
      'Hiện tại, tôi dẫn dắt Verticals Group tại SoC.one — với các đội ngũ phát triển trên robotics, automotive, drones và 5G/6G — đồng thời trực tiếp làm tech lead cho những chương trình chủ chốt: connected driving (C-V2X sidelink), V2X protocol stack, digital twin với kênh vô tuyến ray-traced, và robotics sim-to-real. Điểm chung cốt lõi: đây đều là những hệ thống nơi thế giới mô phỏng phải khớp với thế giới vật lý — và đòi hỏi những đội ngũ vừa kỷ luật và vừa năng động.',
      'Trang web này kể lại câu chuyện của chặng đường đó, kèm một blog nơi tôi chia sẻ góc nhìn về connected driving, robotics và AI. Các quan điểm ở đây thuộc về cá nhân tôi; công việc hiện tại chỉ được đề cập ở phạm vi các công nghệ và tiêu chuẩn kỹ thuật công khai.',
    ],
    eduLabel: 'Học vấn',
    edu: [
      'Thạc sĩ Kỹ thuật Điện & Máy tính — TU Kaiserslautern, Đức (chuyên ngành hệ thống nhúng)',
      'Kỹ sư Điện — Điện tử — Đại học Bách khoa Hà Nội (chuyên ngành vi điện tử)',
    ],
    pubLabel: 'Công bố khoa học',
    contactLabel: 'Liên hệ',
    contact: 'Cách nhanh nhất để liên hệ với tôi là email. Tôi cũng có mặt trên GitHub và LinkedIn.',
  },
}[locale];

const altPath = locale === 'en' ? '/vi/about/' : '/about/';
---

<Base
  locale={locale}
  title={`${content.title} — Canh-Trung Nguyen`}
  description={content.paras[0]}
  altPath={altPath}
>
  <section class="container">
    <header class="page-head">
      <h1>{content.heading}</h1>
    </header>
    <div class="prose">
      {content.paras.map((p) => <p>{p}</p>)}
      <h2>{content.eduLabel}</h2>
      <ul>
        {content.edu.map((e) => <li>{e}</li>)}
      </ul>
      <h2>{content.pubLabel}</h2>
      <ul class="pubs">
        {
          publications.map((p) => (
            <li>
              {p.authors.map((a, i) => (
                <>{i > 0 && ', '}{a === me ? <strong>{a}</strong> : a}</>
              ))}{', “'}{p.href ? <a href={p.href} rel="noopener">{p.title}</a> : p.title}{'”, '}
              <em>{p.venue}</em>.
            </li>
          ))
        }
      </ul>
      <h2>{content.contactLabel}</h2>
      <p>{content.contact}</p>
      <p class="links">
        <a href="mailto:nguyencanhtrung@me.com" aria-label="Email" title="nguyencanhtrung@me.com">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
        </a>
        <a href="https://github.com/nguyencanhtrung" rel="me noopener" aria-label="GitHub" title="github.com/nguyencanhtrung">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/nguyencanhtrung" rel="me noopener" aria-label="LinkedIn" title="linkedin.com/in/nguyencanhtrung">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4V8h4" />
            <rect x="2" y="9" width="4" height="12" />
            <circle cx="4" cy="4" r="2" />
          </svg>
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-top: 4rem;
  }
  .page-head h1 {
    font-size: clamp(2.2rem, 5vw, 3rem);
  }
  .prose {
    margin-top: 2rem;
  }
  .links {
    display: flex;
    gap: 1.1rem;
  }
  .links a {
    color: var(--ink-2);
    transition: color 0.15s ease;
  }
  .links a:hover {
    color: var(--accent);
  }
  .links svg {
    display: block;
    width: 22px;
    height: 22px;
  }
  .pubs li {
    margin-top: 0.6rem;
    line-height: 1.6;
  }
</style>
