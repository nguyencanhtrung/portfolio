---
import { getCollection } from 'astro:content';
import BlogPostPage from '../../components/BlogPostPage.astro';

export async function getStaticPaths() {
  const all = await getCollection('blog', (p) => !p.data.draft);
  const viKeys = new Set(all.filter((p) => p.data.lang === 'vi').map((p) => p.data.key));
  return all
    .filter((p) => p.data.lang === 'en')
    .map((post) => ({
      params: { slug: post.id.replace(/^en\//, '') },
      props: { post, hasTranslation: viKeys.has(post.data.key) },
    }));
}

const { post, hasTranslation } = Astro.props;
---

<BlogPostPage locale="en" post={post} hasTranslation={hasTranslation} />
