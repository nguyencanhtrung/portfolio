---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/vietnamese-400.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of this page in the other locale; omit if no counterpart exists. */
  altPath?: string;
}

const { locale, title, description, altPath } = Astro.props;
const other: Locale = locale === 'en' ? 'vi' : 'en';
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Canh-Trung Nguyen" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    {
      altPath && (
        <>
          <link rel="alternate" hreflang={locale} href={new URL(path, Astro.site)} />
          <link rel="alternate" hreflang={other} href={new URL(altPath, Astro.site)} />
        </>
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
  </head>
  <body>
    <SiteHeader locale={locale} altPath={altPath} />
    <main>
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>

<style>
  main {
    min-height: 70vh;
  }
</style>
